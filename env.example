NEXT_PUBLIC_SHOW_V2_LANDING=bool
NEXT_PUBLIC_API_ENDPOINT=http://localhost:5001/v1/

# Mapbox token for LocationPicker (get from https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

DO_KEY=DigitalOceanKey
DO_SECRET=DigitalOceanSecret

NEXT_PUBLIC_INVESTOR_TYPEFORM_URL=https://typeform.url

NEXT_PUBLIC_BOOKING_FLOW_V3=bool

# GTM Codes:
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXX
NEXT_PUBLIC_GTM_AUTH=codeShared
NEXT_PUBLIC_GTM_PREVIEW=env-1/2 as per env

#S3 Bucket Prefix
NEXT_PUBLIC_S3_PREFIX